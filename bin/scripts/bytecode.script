package game.test

class Point {
    var x
    var y

    func _xx(b) {
        x = x*b
    }

    func set(xx, yy) {
        x = xx
        y = yy
        _xx(2)
    }

    func size() {
        return x*y
    }
}

func entry() {
    var vec = [1,2,3,4]
    revert_vec(vec)
    return vec[0]
}

func revert_vec(vec) {
    var len = vec.size()
    var i = 0
    while i < len/2 {
        var tmp = vec[i]
        vec[i] = vec[len-i-1]
        vec[len-i-1] = tmp
        i = i+1
    }
}

func get_constant() {
    return 64
}