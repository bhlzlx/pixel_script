package game.test

class Point {
    var x
    var y
    func set(xx ,yy) {
        x = xx
        y = yy
        return size()
    }
    func size() {
        return self.x*self.y
    }
}

func entry() {
    helloworld()
    var vec = [1,2,3,4]
    var map =  {
        name : "kusugwa",
        age : 32,
        height: 175
    }
    var point = Point.new()
    var ret = point.set(3, 4)
    revert_vec(vec)
    std.io.print(vec[0], "---", map.name)
    return ret
}

func helloworld() {
    std.io.print("hello,world!")
}

func revert_vec(vec) {
    var len = vec.size()
    var i = 0
    while i < len/2 {
        var tmp = vec[i]
        vec[i] = vec[len-i-1]
        vec[len-i-1] = tmp
        i = i+1
    }
}