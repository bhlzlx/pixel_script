package game.test

var global_var = 1

var the_func = func (n) {
    n.f = 1
    var f = 1
    while n > 0 {
        f = f * n
        n = n - 1
    }
} 

func fact(n) {
    f = 1
    while n > 0 {
        f = f * n
        n = n - 1
    }
}

func compute(n) {
    fact(9)
    var even = 0
    var odd = 0
    var i = 1
    while i < 10 {
        if i % 2 == 0 {
            even = even + 1
        } else {
            odd = odd + i
        }
        i = i + 1
    }
    even + odd
}