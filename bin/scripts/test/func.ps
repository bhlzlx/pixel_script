package test.fn

var fib_n = 4+2

func helloworld() {
    var hello = "hello,"
    var world = "world!"
    var rst = hello + world
    std.io.print(rst, fib(fib_n), "\n")
}

func fib(n) {
    var counter = 0
    var rst = 1
    var last = 1
    while counter<n { 
        var backup = rst
        rst = rst + last
        last = backup
        counter = counter + 1
    }
    return rst
}